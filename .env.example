PORT=3000
JWT_SECRET=change-this-to-a-random-secret
DEFAULT_ADMIN_PASSWORD=admin123
# GID of the host's `docker` group — grants the container read access to
# /var/run/docker.sock without running as root. Auto-detected by deploy.sh.
# Find manually with: getent group docker | cut -d: -f3
DOCKER_GID=999
