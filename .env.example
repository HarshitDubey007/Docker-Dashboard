PORT=3000
JWT_SECRET=change-this-to-a-random-secret
DEFAULT_ADMIN_PASSWORD=admin123
# GID of the host's `docker` group — grants the container read access to
# /var/run/docker.sock without running as root. Auto-detected by deploy.sh.
# Find manually with: getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Security / rate limiting ---
# Set to '1', 'true', or a hop count when running behind a reverse proxy
# (nginx, Cloudflare, etc.) so req.ip resolves to the real client IP.
TRUST_PROXY=loopback
# Global per-IP rate limit on /api/* (window = 1 min).
GLOBAL_RATE_MAX=300
GLOBAL_RATE_WINDOW_MS=60000

# --- Daily maintenance (scripts/daily-maintenance.sh) ---
# Container name to exec the abuse scanner inside.
DASHBOARD_CONTAINER=docker-dashboard
# Auto-block thresholds (per IP, rolling 24h window).
DDOS_REQ_PER_DAY=10000
DDOS_AUTH_FAIL_PER_DAY=50
DDOS_RATE_LIMIT_HITS_PER_DAY=100
# How long a freshly-flagged IP stays blocked.
BLOCK_TTL_HOURS=24
# Set to 1 to also DROP traffic at the host firewall (Linux + root + iptables).
BLOCK_AT_HOST=0
# Set to 1 to prune unused volumes too (DESTRUCTIVE — only if you know other
# host containers don't rely on anonymous volumes).
PRUNE_VOLUMES=0
# Rotate access.log when it exceeds this many bytes (default 50 MiB).
ACCESS_LOG_MAX_BYTES=52428800
